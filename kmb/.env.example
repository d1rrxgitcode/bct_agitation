# Строка подключения к PostgreSQL
DATABASE_URL=postgres://roster_user:roster_password@localhost:5432/roster_db

# Порт, на котором запустится сервер
PORT=3000

# Секрет для подписи сессионных cookie — обязательно замените на случайную строку
SESSION_SECRET=замените-на-длинную-случайную-строку

# Данные первого пользователя (создаются командой "npm run migrate", если такого логина ещё нет)
ADMIN_USERNAME=ю
ADMIN_PASSWORD=ю

# В проде за HTTPS-прокси (nginx) можно включить secure-cookie
NODE_ENV=production
COOKIE_SECURE=false
